generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  user_id       Int      @id @default(autoincrement())
  username      String   @unique
  name          String?
  email         String   @unique
  phone         String?
  gender        String?
  password_hash String?
  status        String   @default("active")
  role          String   @default("user")
  created_at    DateTime @default(now())
  posts         Post[]
  bids          PostBid[]
  orders        Order[]

  @@map("users")
}

model Category {
  category_id Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  icon        String   @default("fa-tags")
  created_at  DateTime @default(now())
  parent_id   Int?
  parent      Category? @relation("CategoryChildren", fields: [parent_id], references: [category_id])
  children    Category[] @relation("CategoryChildren")
  posts       Post[]

  @@map("categories")
}

model Post {
  post_id    Int      @id @default(autoincrement())
  title      String
  content    String
  created_at DateTime @default(now())

  user_id     Int
  category_id Int
  user        User     @relation(fields: [user_id], references: [user_id])
  category    Category @relation(fields: [category_id], references: [category_id])
  price       Int?
  location    String?
  post_type   String   @default("ad")
  featured    Boolean  @default(false)
  images      PostImage[]
  reviews     PostReview[]
  bids        PostBid[]

  @@map("posts")
}

model PostImage {
  image_id  Int    @id @default(autoincrement())
  post_id   Int
  url       String
  mime      String
  size      Int
  order     Int    @default(0)
  post      Post   @relation(fields: [post_id], references: [post_id])

  @@map("post_images")
}

model PostReview {
  review_id  Int      @id @default(autoincrement())
  post_id    Int
  author     String
  rating     Int
  comment    String
  created_at DateTime @default(now())
  post       Post     @relation(fields: [post_id], references: [post_id])

  @@unique([post_id, author])
  @@map("post_reviews")
}

model PostBid {
  bid_id     Int      @id @default(autoincrement())
  post_id    Int
  user_id    Int?
  author     String
  email      String?
  amount     Int
  created_at DateTime @default(now())
  post       Post     @relation(fields: [post_id], references: [post_id])
  user       User?    @relation(fields: [user_id], references: [user_id])

  @@index([post_id])
  @@map("post_bids")
}

model Favorite {
  id          Int      @id @default(autoincrement()) @map("fav_id")
  user_id     Int
  post_id     Int
  created_at  DateTime @default(now())

  @@unique([user_id, post_id])
  @@map("favorites")
}

model PostFlag {
  flag_id     Int      @id @default(autoincrement())
  post_id     Int
  author      String?
  reason      String
  details     String?
  created_at  DateTime @default(now())

  @@map("post_flags")
}

model ChatMessage {
  message_id  Int      @id @default(autoincrement())
  post_id     Int
  author      String?
  recipient   String?
  text        String
  created_at  DateTime @default(now())

  @@index([post_id])
  @@map("chat_messages")
}

model RolePermission {
  permission_id Int      @id @default(autoincrement())
  role          String
  resource      String
  action        String
  created_at    DateTime @default(now())

  @@unique([role, resource, action], name: "role_resource_action")
  @@map("role_permissions")
}

model Order {
  order_id      Int         @id @default(autoincrement())
  order_number  String      @unique
  buyer_id      Int?
  buyer_email   String
  buyer_name    String
  buyer_phone   String
  shipping_full_name String
  shipping_email    String
  shipping_phone    String
  shipping_address  String
  shipping_city     String
  shipping_postal_code String
  payment_method     String      @default("cash_on_delivery")
  status            String      @default("pending")
  subtotal          Int
  shipping_cost     Int
  total             Int
  notes             String?
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt
  buyer             User?       @relation(fields: [buyer_id], references: [user_id])
  items             OrderItem[]

  @@index([buyer_id])
  @@index([order_number])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  order_item_id Int      @id @default(autoincrement())
  order_id      Int
  post_id       Int?
  title         String
  price         Int
  image_url     String?
  location      String?
  order         Order    @relation(fields: [order_id], references: [order_id], onDelete: Cascade)

  @@index([order_id])
  @@index([post_id])
  @@map("order_items")
}