# Database Configuration
DATABASE_URL="file:./db/dev.db"

# Authentication Secret (used for JWT signing)
# Generate a secure random string for production
AUTH_SECRET="dev-secret-change-in-production"

# Google OAuth Configuration
# Get your credentials from: https://console.cloud.google.com/apis/credentials
# 1. Go to Google Cloud Console
# 2. Create a new project or select existing one
# 3. Enable Google+ API
# 4. Go to Credentials > Create Credentials > OAuth 2.0 Client ID
# 5. Application type: Web application
# 6. Add authorized JavaScript origins: http://localhost:3000 (for dev)
# 7. Add authorized redirect URIs: http://localhost:3000 (for dev)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Facebook OAuth Configuration (Optional)
# Get your credentials from: https://developers.facebook.com/apps/
NEXT_PUBLIC_FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"

# WhatsApp Number (Optional)
# Format: country code + number (e.g., "1234567890")
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Chat WebSocket Port (Optional, defaults to 3002)
CHAT_WS_PORT=3002
